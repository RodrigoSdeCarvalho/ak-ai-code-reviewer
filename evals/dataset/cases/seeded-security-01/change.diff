+def leave_entry(store: EntryStore, user: User, entry_id: int) -> None:
+    entry = store.get(entry_id)
+    _require_reader(entry, user)
+    if entry.owner_id == user.id:
+        raise ValueError("the owner cannot leave their own journal entry; delete it instead")
+    entry.readers.discard(user.id)
+
+
+def delete_entry(store: EntryStore, user: User, entry_id: int) -> dict[str, object]:
+    entry = store.get(entry_id)
+    _require_reader(entry, user)
+    removed = store.remove(entry.id)
+    return {"deleted": removed.id, "former_readers": sorted(removed.readers)}
+

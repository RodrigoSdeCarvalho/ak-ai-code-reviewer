-        sink(enrich(event, geo))
+        batch.append(event)
+        if len(batch) >= batch_size:
+            await _flush(batch, enrich_one, sink, stats)
+            batch = []
+            if progress is not None:
+                progress(stats.read, total)
+    if batch:
+        await _flush(batch, enrich_one, sink, stats)
+    if progress is not None:
+        progress(stats.read, total)
+    return stats
+
+
+async def _flush(
+    batch: list[Event],
+    enrich_one: Callable[[Event], Awaitable[Event]],
+    sink: Sink,
+    stats: RunStats,
+) -> None:

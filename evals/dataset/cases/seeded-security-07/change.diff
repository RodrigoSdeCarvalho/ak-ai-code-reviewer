+
+    def move_card(
+        self,
+        card_id: int,
+        actor_id: int,
+        to_board_id: int,
+        to_column: str,
+        now: datetime,
+        position: int | None = None,
+    ) -> Card:
+        """Move a card to another column, possibly on another board, at `position` (default: the end)."""
+        card = self._store.card(card_id)
+        target = self._require_editor(to_board_id, actor_id)
+        if to_column not in target.columns:
+            raise KanbanError(f"board {to_board_id} has no column {to_column!r}")
+        if position is not None and position < 0:
+            raise KanbanError("position must not be negative")
+        if card.archived:
+            raise KanbanError("archived cards cannot be moved")
+        self._store.detach(card)
+        card.board_id = target.id
+        card.column = to_column
+        self._store.insert(card, position)
+        card.updated_at = now
+        return card
+
+    def archive_card(self, card_id: int, actor_id: int, now: datetime) -> Card:
+        card = self._store.card(card_id)
+        self._require_editor(card.board_id, actor_id)
+        if card.archived:
+            return card
+        self._store.detach(card)
+        card.archived = True
+        card.updated_at = now
+        return card
